#include <stdio.h>

int main() {
    float num1, num2, resultado;
    char operador;
    
    printf("Digite o primeiro numero: ");
    scanf("%f", &num1);
    
    printf("Digite o operador (+, -, *, /): ");
    scanf(" %c", &operador); // Espaco antes de %c limpa o buffer
    
    printf("Digite o segundo numero: ");
    scanf("%f", &num2);
    
    switch(operador) {
        case '+':
            resultado = num1 + num2;
            break;
        case '-':
            resultado = num1 - num2;
            break;
        case '*':
            resultado = num1 * num2;
            break;
        case '/':
            if (num2 != 0) {
                resultado = num1 / num2;
            } else {
                printf("\nErro: Divisao por zero nao e permitida!\n");
                return 1;
            }
            break;
        default:
            printf("\nErro: Operador invalido!\n");
            return 1;
    }
    
    printf("\nResultado: %.2f %c %.2f = %.2f\n", num1, operador, num2, resultado);
    return 0;
}
