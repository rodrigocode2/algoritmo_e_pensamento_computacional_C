#include <stdio.h>

int main() {
    // Declarando as variáveis
    int num1, num2, num3;

    // Realizando a leitura
    printf("Escreva o 1o numero: ");
    scanf("%d", &num1);

    printf("Escreva o 2o numero: ");
    scanf("%d", &num2);

    printf("Escreva o 3o numero: ");
    scanf("%d", &num3);

    // Estrutura condicional para encontrar o maior
    if (num1 >= num2 && num1 >= num3) {
        printf("Maior %d\n", num1);
    } 
    else if (num2 >= num3) {
        printf("Maior %d\n", num2);
    } 
    else {
        printf("Maior %d\n", num3);
    }

    return 0;
}
