#include <stdio.h>

int main() {
    float nota1, nota2, nota3, media;

    printf("Digite a primeira nota: ");
    scanf("%f", &nota1);

    printf("Digite a segunda nota: ");
    scanf("%f", &nota2);

    printf("Digite a terceira nota: ");
    scanf("%f", &nota3);

    media = (nota1 + nota2 + nota3) / 3.0; // Usar 3.0 indica divisão com float

    printf("\nA media e: %.2f\n", media);

    // Uso de chaves e quebra de linha (\n) para melhor organização
    if (media >= 6.0) {
        printf("Situação: Aprovado!\n");
    } else {
        printf("Situação: Reprovado!\n");
    }

    return 0;
}
